[Unit]
Description=DeltaBacklog nightly database backup
After=deltabacklog.service

[Service]
Type=oneshot
User=deltabacklog
Group=deltabacklog
EnvironmentFile=/etc/deltabacklog.env
WorkingDirectory=/var/lib/deltabacklog
ExecStart=/opt/deltabacklog/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/deltabacklog /var/backups/deltabacklog
