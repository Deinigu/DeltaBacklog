# Copy to .env (never commit it). Real environment variables win over this file.
# On the Raspberry Pi the same settings live in /etc/deltabacklog.env (deploy/deploy.sh --env .env copies the keys there).

# Where to listen. Use 127.0.0.1:8081 to keep the app on this machine only.
LISTEN_ADDR=:8081
# Where app.db and covers/ are stored.
DATA_DIR=./data
# Where screenshots are stored (default: DATA_DIR/screenshots). When set, the folder must already exist: the app
# never creates it, so an external drive that is not mounted cannot be written onto the system disk.
# SCREENSHOTS_DIR=/mnt/drive/deltabacklog/screenshots
# Limits in megabytes: one screenshot (25) and one upload request (200).
# SCREENSHOT_MAX_MB=25
# SCREENSHOT_REQUEST_MAX_MB=200
# Most memory (MB) the server may need to decode one screenshot for its thumbnail; bigger ones get the browser's thumbnail.
# SCREENSHOTS_DECODE_BUDGET_MB=48

# IGDB: game lookups (add a game, Fill from IGDB, sync-igdb) and the Series, Upcoming and Similar games pages.
# Create a Twitch application at https://dev.twitch.tv/console/apps and copy its Client ID and Secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# SteamGridDB covers and posters: https://www.steamgriddb.com/ -> Preferences -> API
STEAMGRIDDB_API_KEY=
# IsThereAnyDeal API key for the Deals page (prices of the backlog and up next games): https://isthereanydeal.com/apps/
ITAD_API_KEY=
# Extra Host names the app answers to (comma separated), for a router, Tailscale or reverse-proxy name. IP addresses,
# localhost, deltabacklog.local and the machine hostname (and <hostname>.local) are always allowed. Example: games.example.org
ALLOWED_HOSTS=

# Raspberry Pi only (read by deploy/install.sh and the nightly backup, not by the app):
# PUBLIC_NAME=off turns off the deltabacklog.local name and the port 80 rules, for an app reached only through a reverse proxy
# (then also set LISTEN_ADDR=127.0.0.1:8081).
# PUBLIC_NAME=
# Free space (GB) the nightly screenshot copy must leave on the backup disk.
# SHOTS_MIN_FREE_GB=5

# Go runtime soft memory limit (the Raspberry Pi install uses 96MiB).
# GOMEMLIMIT=96MiB
