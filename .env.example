# Copy to .env (never commit it). Real environment variables win over this file.

# Where to listen. Use 127.0.0.1:8081 to keep the app on this machine only.
LISTEN_ADDR=:8081
# Where app.db and covers/ are stored.
DATA_DIR=./data
# Where screenshots are stored (default: DATA_DIR/screenshots). When set, the folder must already exist: the app
# never creates it, so an external drive that is not mounted cannot be written onto the system disk.
# SCREENSHOTS_DIR=/mnt/drive/deltabacklog/screenshots
# Limits in megabytes: one screenshot (25) and one upload request (200).
# SCREENSHOT_MAX_MB=25
# SCREENSHOT_REQUEST_MAX_MB=200
# Most memory (MB) the server may need to decode one screenshot for its thumbnail; bigger ones get the browser's thumbnail.
# SCREENSHOTS_DECODE_BUDGET_MB=48

# Needed only for game lookups (add a game, Fill from IGDB, sync-igdb). Without them you add games by hand.
# IGDB: create a Twitch application at https://dev.twitch.tv/console/apps and copy its Client ID and Secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# SteamGridDB covers: https://www.steamgriddb.com/ -> Preferences -> API
STEAMGRIDDB_API_KEY=
# IsThereAnyDeal API key for the Deals page (prices of the wishlist and backlog): https://isthereanydeal.com/apps/
ITAD_API_KEY=
# Extra Host names the app answers to (comma separated). IP addresses, localhost, deltabacklog.local and the
# machine hostname (and <hostname>.local) are always allowed. Example: ALLOWED_HOSTS=games.example.org
ALLOWED_HOSTS=

# Optional: Go runtime soft memory limit (the Raspberry Pi install uses 96MiB).
# GOMEMLIMIT=96MiB
