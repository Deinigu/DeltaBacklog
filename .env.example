# Copy to .env (never commit it)
LISTEN_ADDR=:8081
DATA_DIR=./data
# Needed only for quick-add lookups (features/quick-add)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAMGRIDDB_API_KEY=
# Extra Host names the app answers to (comma separated). IP addresses, localhost, deltabacklog.local and the
# machine hostname (and <hostname>.local) are always allowed. Example: ALLOWED_HOSTS=games.example.org
ALLOWED_HOSTS=
