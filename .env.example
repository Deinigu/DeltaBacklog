# Copy to .env (never commit it). Real environment variables win over this file; an empty value means "use the default".
# On the Raspberry Pi the same settings live in /etc/deltabacklog.env (deploy/deploy.sh --env .env copies the keys there).

# Address and port to serve on (default :8081); use 127.0.0.1:8081 to keep the app on this machine only.
LISTEN_ADDR=
# Folder for app.db and covers/ (default ./data).
DATA_DIR=
# Folder for screenshots (default DATA_DIR/screenshots); when set it must already exist, so an unmounted drive is never filled.
SCREENSHOTS_DIR=
# Largest single screenshot in megabytes (default 25).
SCREENSHOT_MAX_MB=
# Largest upload request in megabytes (default 200).
SCREENSHOT_REQUEST_MAX_MB=
# Most memory in megabytes to decode one picture for its thumbnail (default 48); bigger ones get the browser's thumbnail.
SCREENSHOTS_DECODE_BUDGET_MB=

# IGDB (game lookups, Series, Upcoming, Similar games): Client ID of a Twitch app from https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
# IGDB: the Client Secret of that Twitch app.
IGDB_CLIENT_SECRET=
# SteamGridDB covers and posters: the key from https://www.steamgriddb.com/ -> Preferences -> API
STEAMGRIDDB_API_KEY=
# IsThereAnyDeal key for the Deals page: https://isthereanydeal.com/apps/
ITAD_API_KEY=
# Optional, your Steam wishlist on Deals: your 17-digit SteamID64 (the wishlist must be public, no Steam key is needed).
STEAM_ID=
# Optional, price alerts on your phone: the bot token from @BotFather (looks like 123456789:ABC...).
TELEGRAM_BOT_TOKEN=
# Optional, price alerts on your phone: the chat id to send to (a number, -100... for a group, or @channelname).
TELEGRAM_CHAT_ID=

# Extra Host names the app answers to, comma separated (a router, Tailscale or reverse-proxy name); IPs, localhost and deltabacklog.local always work.
ALLOWED_HOSTS=

# Raspberry Pi only, read by deploy/install.sh: off turns off deltabacklog.local and the port 80 rules (then also set LISTEN_ADDR=127.0.0.1:8081).
PUBLIC_NAME=
# Raspberry Pi only, read by the nightly backup: free space in GB the screenshot copy leaves on the backup disk (default 5).
SHOTS_MIN_FREE_GB=
# Go runtime soft memory limit, for example 96MiB (the Raspberry Pi install sets it).
GOMEMLIMIT=
